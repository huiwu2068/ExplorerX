{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: Debug x64",
      "type": "shell",
      "command": "call \"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\2022\\BuildTools\\Common7\\Tools\\VsDevCmd.bat\" -arch=x64 -host_arch=x64 && msbuild \"${workspaceFolder}\\Explorer++\\ExplorerX\\ExplorerX.vcxproj\" /m /p:Configuration=Debug /p:Platform=x64 /p:SolutionDir=${workspaceFolder}\\Explorer++\\ /p:UseMultiToolTask=true /p:CL_MPCount=%NUMBER_OF_PROCESSORS%",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/d",
            "/s",
            "/c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "build: Release x64",
      "type": "shell",
      "command": "call \"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\2022\\BuildTools\\Common7\\Tools\\VsDevCmd.bat\" -arch=x64 -host_arch=x64 && msbuild \"${workspaceFolder}\\Explorer++\\ExplorerX\\ExplorerX.vcxproj\" /m /p:Configuration=Release /p:Platform=x64 /p:SolutionDir=${workspaceFolder}\\Explorer++\\ /p:UseMultiToolTask=true /p:EnforceProcessCountAcrossBuilds=true /p:CL_MPCount=%NUMBER_OF_PROCESSORS% /p:LinkAdditionalOptions=\"/CGTHREADS:%NUMBER_OF_PROCESSORS%\"",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/d",
            "/s",
            "/c"
          ]
        }
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "index: clangd (Debug x64)",
      "type": "shell",
      "command": "call \"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\2022\\BuildTools\\Common7\\Tools\\VsDevCmd.bat\" -arch=x64 -host_arch=x64 && \"${env:LOCALAPPDATA}\\Tools\\msbuild-compdb\\msbuild-compdb.exe\" --build \"${workspaceFolder}\\Explorer++\\ExplorerX\\ExplorerX.vcxproj\" --output \"${workspaceFolder}\\compile_commands.json\" -- /m /t:Rebuild /p:Configuration=Debug /p:Platform=x64 /p:SolutionDir=${workspaceFolder}\\Explorer++\\",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/d",
            "/s",
            "/c"
          ]
        }
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
